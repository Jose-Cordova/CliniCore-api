{
  "include": [
    "src/main/java/**/*.java",
    "src/main/resources/**/*.yml",
    "src/main/resources/**/*.properties",
    "src/main/resources/db/migration/**",
    "src/test/java/**/*.java",
    "pom.xml",
    "docs/**",
    "README.md",
    "AGENTS.md"
  ],
  "exclude": [
    "target/**",
    ".mvn/**",
    "mvnw",
    "mvnw.cmd",
    "src/main/resources/application-*.yml",
    "src/main/resources/application-*.properties",
    "**/*.class",
    "**/*.jar",
    "**/*.war",
    "**/*.log",
    ".idea/**",
    "*.iml",
    "HELP.md"
  ]
}